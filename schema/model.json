{
  "$schema": "./model.schema.json",
  "name": "mof-synthesizability",
  "version": "1.0.0",

  "assets": {
    "artifacts/clf_LOF.joblib": {
      "type": "file",
      "mime_type": "application/octet-stream",
      "required": true,
      "description": "pyod Local Outlier Factor classifier"
    },
    "artifacts/clf_LUNAR.joblib": {
      "type": "file",
      "mime_type": "application/octet-stream",
      "required": true,
      "description": "pyod LUNAR classifier (PyTorch-backed)"
    },
    "artifacts/deep_model.tar": {
      "type": "file",
      "mime_type": "application/octet-stream",
      "required": true,
      "description": "Deep SVDD set-transformer checkpoint ({R, c, net_dict, ae_net_dict})"
    },
    "artifacts/lof_scaler.joblib": {
      "type": "file",
      "mime_type": "application/octet-stream",
      "required": true,
      "description": "MinMax scaler for the LOF score"
    },
    "artifacts/lunar_scaler.joblib": {
      "type": "file",
      "mime_type": "application/octet-stream",
      "required": true,
      "description": "MinMax scaler for the LUNAR score"
    },
    "artifacts/deep_scaler.joblib": {
      "type": "file",
      "mime_type": "application/octet-stream",
      "required": true,
      "description": "MinMax scaler for the Deep SVDD score"
    },
    "artifacts/metal_scaled.csv": {
      "type": "file",
      "mime_type": "text/csv",
      "required": true,
      "description": "Pre-scaled metal descriptors, indexed by element Symbol"
    }
  },

  "parameters": {},

  "execution": {
    "modes": {
      "instance": {
        "description": "Predict the synthesizability of a single MOF from a linker SMILES and a metal symbol, using three anomaly-detection models (LOF, LUNAR, Deep SVDD). Returns each model's normalised score and its synthesizable/not verdict.",
        "response": "immediate",
        "inputs": {
          "linker": {
            "type": "string",
            "required": true,
            "description": "SMILES string of the organic linker, e.g. O=C(O)c1ccc(cc1)C(=O)O"
          },
          "metal": {
            "type": "string",
            "required": true,
            "description": "Element symbol of the metal (only metals the models were trained on)",
            "enum": ["Ag", "Al", "Ba", "Be", "Bi", "Ca", "Cd", "Ce", "Co", "Cr", "Cs", "Cu", "Dy", "Er", "Eu", "Fe", "Ga", "Gd", "Hf", "Hg", "Ho", "In", "K", "La", "Li", "Lu", "Mg", "Mn", "Mo", "Na", "Nd", "Ni", "Pb", "Pr", "Rb", "Ru", "Sb", "Sc", "Sm", "Sn", "Sr", "Tb", "Th", "Ti", "Tl", "Tm", "U", "V", "W", "Y", "Yb", "Zn", "Zr"]
          }
        },
        "outputs": {
          "linker": { "type": "string", "description": "Canonical linker SMILES used" },
          "metal": { "type": "string", "description": "Metal symbol used" },
          "lof": {
            "type": "object",
            "description": "Local Outlier Factor model result",
            "properties": {
              "score": { "type": "number", "description": "Normalised synthesizability score (0-1)" },
              "synthesizable": { "type": "boolean", "description": "score > 0.81" }
            }
          },
          "lunar": {
            "type": "object",
            "description": "LUNAR model result",
            "properties": {
              "score": { "type": "number", "description": "Normalised synthesizability score (0-1)" },
              "synthesizable": { "type": "boolean", "description": "score > 0.55" }
            }
          },
          "deep_svdd": {
            "type": "object",
            "description": "Deep SVDD (set-transformer) model result",
            "properties": {
              "score": { "type": "number", "description": "Normalised synthesizability score (0-1)" },
              "synthesizable": { "type": "boolean", "description": "score > 0.86" }
            }
          }
        }
      },

      "dataset": {
        "description": "Batch-predict MOF synthesizability from a CSV of linker,metal pairs (one MOF per row). Produces a downloadable CSV of per-model scores and verdicts.",
        "response": "deferred",
        "inputs": {
          "file": {
            "type": "file",
            "mime_type": "text/csv",
            "required": true,
            "description": "CSV of MOFs, one per row: the linker SMILES and the metal's element symbol",
            "header": true,
            "columns": [
              {
                "name": "linker",
                "description": "SMILES string of the organic linker, e.g. O=C(O)c1ccc(cc1)C(=O)O",
                "type": "string"
              },
              {
                "name": "metal",
                "description": "Element symbol of the metal, e.g. Zn; one of the metals the models were trained on (as listed in instance mode)",
                "type": "string"
              }
            ],
            "example": "linker,metal\nO=C(O)c1ccc(cc1)C(=O)O,Zn\nO=C(O)c1ccc(cc1)C(=O)O,Cu\nc1cc(cc(c1)C(=O)O)C(=O)O,Fe\nO=C(O)c1cccc(c1)C(=O)O,Al\n"
          }
        },
        "outputs": {
          "predictions.csv": {
            "type": "file",
            "mime_type": "text/csv",
            "description": "Input rows augmented with each model's score and synthesizable verdict"
          }
        }
      }
    }
  }
}
